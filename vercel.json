{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/accommodations",
      "destination": "/stays",
      "permanent": true
    },
    {
      "source": "/accommodations/:slug*",
      "destination": "/stays",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/products/:slug*",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/chiang-mai",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/elephant-sanctuary-thailand-doilom-tour",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/elephant-sanctuary-thailand-doilom-tour/:slug*",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/full-day-elephant-care",
      "destination": "/tours/full-day-elephant-care",
      "permanent": true
    },
    {
      "source": "/half-day-elephant-care",
      "destination": "/tours/morning-elephant-care",
      "permanent": true
    },
    {
      "source": "/elephant-care",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/elephant-care/:slug*",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/tours",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    }
  ]
}
