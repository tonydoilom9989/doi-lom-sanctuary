        "value": [
          { "x": "0", "y": "8px", "blur": "20px", "spread": "-6px", "color": "rgba(37,211,102,0.55)", "type": "dropShadow" }
        ],
        "type": "boxShadow",
        "description": "WhatsApp button hover glow"
      }
