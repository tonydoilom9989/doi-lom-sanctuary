            <div class="mt-4 grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-7 gap-3">
              {cat.names.map((iconName) => (
                <div class="card p-4 flex flex-col items-center gap-2 text-center">
                  <div class="text-[var(--color-forest)]">
                    <Icon name={iconName} size={28} />
