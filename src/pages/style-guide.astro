---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/icons/Icon.astro";

// =====================================================================
// COLOR TOKENS — grouped by purpose
// =====================================================================
const colorGroups = [
  {
    name: "Surfaces",
    tokens: [
      { name: "bg", value: "#fffdf9", note: "Page background" },
      { name: "paper", value: "#fffdf9", note: "Card surface" },
      { name: "surface", value: "#faf6ec", note: "Tinted surface" },
      { name: "bone", value: "#f5ede3", note: "Warm beige" },
      { name: "cream", value: "#f2eae0", note: "Saturated warm" },
      { name: "amber-surface", value: "#fbf5ee", note: "Warning surface" },
    ],
  },
  {
    name: "Borders & lines",
    tokens: [
      { name: "line", value: "#ead9c5", note: "Default border" },
      { name: "line-amber", value: "#edd9bf", note: "Amber border" },
      { name: "line-sage", value: "#c8ddb8", note: "Sage border" },
    ],
  },
  {
    name: "Forest green (brand)",
    tokens: [
      { name: "leaf-50", value: "#f0f5ec", note: "Lightest sage" },
      { name: "leaf-100", value: "#c8ddb8", note: "Light sage" },
      { name: "leaf-200", value: "#b4cfa6", note: "Mid-light sage" },
      { name: "leaf-300", value: "#9dc27e", note: "Sage green" },
      { name: "leaf-400", value: "#7a9e6c", note: "Mid forest" },
      { name: "forest", value: "#3a5c2a", note: "★ PRIMARY brand" },
      { name: "forest-dark", value: "#2c4a1e", note: "Primary hover" },
      { name: "forest-darker", value: "#1a3010", note: "Gradient overlay" },
      { name: "canopy", value: "#0d1f08", note: "Tree silhouette" },
      { name: "overlay", value: "#162810", note: "Modal backdrop" },
    ],
  },
  {
    name: "Earth & accent",
    tokens: [
      { name: "clay", value: "#d4b48a", note: "Earth tint" },
      { name: "amber", value: "#a0674a", note: "Shield/warning" },
      { name: "warn-yellow", value: "#f0e4c4", note: "Easy chip" },
      { name: "warn-orange", value: "#f5d5b8", note: "Moderate chip" },
      { name: "warn-red", value: "#c66454", note: "Destructive" },
    ],
  },
  {
    name: "Text",
    tokens: [
      { name: "ink", value: "#1a1a14", note: "Primary text" },
      { name: "soil", value: "#3a3024", note: "Secondary" },
      { name: "mute", value: "#6b5f4a", note: "Muted" },
      { name: "stone", value: "#8a7560", note: "Lightest muted" },
    ],
  },
  {
    name: "Footer (dark)",
    tokens: [
      { name: "footer", value: "#2c1f14", note: "Footer bg" },
      { name: "footer-line", value: "#3a2c1a", note: "Footer divider" },
    ],
  },
  {
    name: "WhatsApp brand",
    tokens: [
      { name: "wa", value: "#25d366", note: "WhatsApp green" },
      { name: "wa-dark", value: "#128c4d", note: "WhatsApp hover" },
    ],
  },
];

// =====================================================================
// SPACING SCALE
// =====================================================================
const spacingScale = [
  { name: "1", value: "4px" },
  { name: "2", value: "8px" },
  { name: "3", value: "12px" },
  { name: "4", value: "16px" },
  { name: "5", value: "20px" },
  { name: "6", value: "24px" },
  { name: "8", value: "32px" },
  { name: "10", value: "40px" },
  { name: "12", value: "48px" },
  { name: "16", value: "64px" },
  { name: "20", value: "80px" },
];

// =====================================================================
// BORDER RADIUS
// =====================================================================
const radii = [
  { name: "sm", value: "6px" },
  { name: "md", value: "8px" },
  { name: "lg", value: "12px" },
  { name: "xl", value: "16px" },
  { name: "2xl", value: "20px" },
  { name: "full", value: "9999px" },
];

// =====================================================================
// SHADOWS
// =====================================================================
const shadows = [
  { name: "soft", cssClass: "shadow-soft-preview", note: "Subtle surface lift" },
  { name: "card", cssClass: "shadow-card-preview", note: "Default card shadow" },
  { name: "lift", cssClass: "shadow-lift-preview", note: "Card hover lift" },
];

// =====================================================================
// ICONS — all icons in Icon.astro (curated list)
// =====================================================================
const iconCatalog = [
  { category: "Brand / Social", names: ["whatsapp", "facebook", "instagram"] },
  { category: "UI / Actions", names: ["x", "x-circle", "check", "check-circle", "plus", "search", "menu", "chevron", "chevron-down", "chevron-up", "arrow", "arrow-left", "external", "copy", "share", "zoom", "image"] },
  { category: "Info / Status", names: ["star", "clock", "pin", "globe", "language", "mail", "card", "calendar", "calendar-x", "shield", "certificate", "user-circle"] },
  { category: "Nature / Theme", names: ["mountain", "trees", "paw", "heart", "apple", "sun", "cloud-sun", "home", "elephant"] },
  { category: "Stay / Tour stats", names: ["bed", "ruler", "eye", "pool", "users"] },
  { category: "Payment / Transport", names: ["transfer", "qr", "bank", "car", "taxi", "bus"] },
  { category: "Misc", names: ["unlock", "ban", "fork"] },
];

// =====================================================================
// NAV — anchor links
// =====================================================================
const sections = [
  { id: "colors", label: "Colors" },
  { id: "typography", label: "Typography" },
  { id: "spacing", label: "Spacing" },
  { id: "radius", label: "Radius" },
  { id: "shadows", label: "Shadows" },
  { id: "buttons", label: "Buttons" },
  { id: "chips", label: "Chips" },
  { id: "cards", label: "Cards" },
  { id: "forms", label: "Forms" },
  { id: "callouts", label: "Callouts" },
  { id: "links", label: "Links" },
  { id: "icons", label: "Icons" },
];
---

<Layout title="Style Guide" description="Doi Lom Elephant Rescue Sanctuary — visual design system reference" noindex={true}>
  {/* ============ HERO ============ */}
  <section class="bg-[var(--color-cream)] border-b border-[var(--color-line)]">
    <div class="wrap py-12 lg:py-16">
      <p class="eyebrow eyebrow-green">Design System</p>
      <h1 class="mt-3">Style Guide</h1>
      <p class="mt-4 text-[var(--color-soil)] leading-relaxed max-w-2xl">
        Visual reference of every design token, component, and pattern used in this site. Updated automatically from the codebase.
      </p>

      {/* Anchor nav */}
      <div class="mt-7 flex flex-wrap gap-2">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="chip chip-sage py-1.5">{s.label}</a>
        ))}
      </div>
    </div>
  </section>

  {/* ============ COLORS ============ */}
  <section id="colors" class="py-12 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Section 1</p>
      <h2 class="mt-3">Colors</h2>
      <p class="mt-3 text-[var(--color-mute)]">33 color tokens grouped by purpose.</p>

      <div class="mt-10 grid gap-10">
        {colorGroups.map((group) => (
          <div>
            <h3 class="font-display text-[1.25rem] text-[var(--color-ink)]">{group.name}</h3>
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
              {group.tokens.map((t) => (
                <div class="card overflow-hidden">
                  <div
                    class="h-20 border-b border-[var(--color-line)] swatch"
                    style={{ backgroundColor: t.value }}
                  ></div>
                  <div class="p-3">
                    <p class="font-medium text-[0.88rem] text-[var(--color-ink)]">{t.name}</p>
                    <p class="text-[0.74rem] text-[var(--color-mute)] mt-0.5 font-mono">{t.value}</p>
                    <p class="text-[0.72rem] text-[var(--color-stone)] mt-1">{t.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ TYPOGRAPHY ============ */}
  <section id="typography" class="py-12 lg:py-16 bg-[var(--color-cream)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <p class="eyebrow">Section 2</p>
      <h2 class="mt-3">Typography</h2>
      <p class="mt-3 text-[var(--color-mute)]">DM Serif Display (headings) + Inter (body).</p>

      <div class="mt-10 grid gap-6">
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">h1 · DM Serif Display · clamp(2.5rem, 5.5vw, 3.4rem)</p>
          <h1 class="mt-3">The elephants decide.</h1>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">h2 · DM Serif Display · clamp(1.75rem, 3.8vw, 2.4rem)</p>
          <h2 class="mt-3">From one elephant to a family</h2>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">h3 · DM Serif Display · clamp(1.25rem, 2vw, 1.5rem)</p>
          <h3 class="mt-3">Half Day Elephant Care Experience</h3>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">h4 · DM Serif Display · clamp(1.05rem, 1.4vw, 1.25rem)</p>
          <h4 class="mt-3">Section subheading</h4>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">Body · Inter · 16px · line-height 1.6</p>
          <p class="mt-3 text-[var(--color-ink)] leading-[1.6]">Tony was hardworking and determined from a young age. He saved money through years of dedicated work. This is the default body text style — Inter 16px, regular weight, comfortable line-height.</p>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">Eyebrow · Inter · 0.66rem · semibold · uppercase · 0.18em tracking</p>
          <p class="eyebrow mt-3">Our Story</p>
          <p class="eyebrow eyebrow-green mt-2">Tours</p>
        </div>
      </div>
    </div>
  </section>

  {/* ============ SPACING ============ */}
  <section id="spacing" class="py-12 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Section 3</p>
      <h2 class="mt-3">Spacing</h2>
      <p class="mt-3 text-[var(--color-mute)]">4/8dp scale used throughout layout.</p>

      <div class="mt-10 grid gap-2">
        {spacingScale.map((s) => (
          <div class="card flex items-center gap-4 px-4 py-2">
            <div class="bg-[var(--color-forest)]" style={`width:${s.value};height:24px;flex-shrink:0;`}></div>
            <div class="flex items-baseline gap-3">
              <span class="font-medium text-[0.92rem] text-[var(--color-ink)]">{s.name}</span>
              <span class="text-[0.78rem] text-[var(--color-mute)] font-mono">{s.value}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ BORDER RADIUS ============ */}
  <section id="radius" class="py-12 lg:py-16 bg-[var(--color-cream)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <p class="eyebrow">Section 4</p>
      <h2 class="mt-3">Border radius</h2>
      <p class="mt-3 text-[var(--color-mute)]">Corner radius scale for surfaces.</p>

      <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {radii.map((r) => (
          <div class="text-center">
            <div class="bg-[var(--color-forest)] aspect-square w-full" style={`border-radius:${r.value}`}></div>
            <p class="mt-3 font-medium text-[0.88rem] text-[var(--color-ink)]">radius-{r.name}</p>
            <p class="text-[0.74rem] text-[var(--color-mute)] font-mono">{r.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ SHADOWS ============ */}
  <section id="shadows" class="py-12 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Section 5</p>
      <h2 class="mt-3">Shadows</h2>
      <p class="mt-3 text-[var(--color-mute)]">Elevation scale for cards and surfaces.</p>

      <div class="mt-10 grid sm:grid-cols-3 gap-6">
        {shadows.map((s) => (
          <div class="text-center">
            <div class={`bg-[var(--color-paper)] rounded-xl border border-[var(--color-line)] aspect-[4/3] w-full ${s.cssClass}`}></div>
            <p class="mt-4 font-medium text-[0.92rem] text-[var(--color-ink)]">shadow-{s.name}</p>
            <p class="text-[0.78rem] text-[var(--color-mute)] mt-1">{s.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ BUTTONS ============ */}
  <section id="buttons" class="py-12 lg:py-16 bg-[var(--color-cream)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <p class="eyebrow">Section 6</p>
      <h2 class="mt-3">Buttons</h2>
      <p class="mt-3 text-[var(--color-mute)]">5 button variants used across the site.</p>

      <div class="mt-10 grid gap-4">
        <div class="card p-6 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="font-medium text-[0.92rem] text-[var(--color-ink)]">.btn-primary</p>
            <p class="text-[0.78rem] text-[var(--color-mute)] mt-0.5">Main CTA · 44px height · forest green</p>
          </div>
          <button type="button" class="btn-primary">Book this tour</button>
        </div>
        <div class="card p-6 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="font-medium text-[0.92rem] text-[var(--color-ink)]">.btn-outline</p>
            <p class="text-[0.78rem] text-[var(--color-mute)] mt-0.5">Secondary · 42px height · neutral border</p>
          </div>
          <button type="button" class="btn-outline">Read more</button>
        </div>
        <div class="card p-6 flex flex-wrap items-center justify-between gap-4 bg-[var(--color-forest-dark)]">
          <div>
            <p class="font-medium text-[0.92rem] text-white">.btn-outline-white</p>
            <p class="text-[0.78rem] text-white/65 mt-0.5">On dark hero · 42px · white border</p>
          </div>
          <button type="button" class="btn-outline-white">View all tours</button>
        </div>
        <div class="card p-6 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="font-medium text-[0.92rem] text-[var(--color-ink)]">.btn-whatsapp</p>
            <p class="text-[0.78rem] text-[var(--color-mute)] mt-0.5">WhatsApp action · 44px · brand green</p>
          </div>
          <button type="button" class="btn-whatsapp">
            <Icon name="whatsapp" size={16} />
            Chat with Tony
          </button>
        </div>
        <div class="card p-6 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="font-medium text-[0.92rem] text-[var(--color-ink)]">.btn-ghost-light</p>
            <p class="text-[0.78rem] text-[var(--color-mute)] mt-0.5">Subtle CTA · 40px · sage bg</p>
          </div>
          <button type="button" class="btn-ghost-light">See more</button>
        </div>
      </div>
    </div>
  </section>

  {/* ============ CHIPS ============ */}
  <section id="chips" class="py-12 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Section 7</p>
      <h2 class="mt-3">Chips & pills</h2>
      <p class="mt-3 text-[var(--color-mute)]">Pill-shaped labels for metadata, tags, and filters.</p>

      <div class="mt-10 grid gap-6">
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">.chip · default</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip">Full day</span>
            <span class="chip">Half day</span>
            <span class="chip">2 to 8 guests</span>
            <span class="chip">EN · TH</span>
          </div>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">.chip.chip-sage</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip chip-sage">Mae Taeng Village</span>
            <span class="chip chip-sage">Local Team</span>
            <span class="chip chip-sage">Family-Owned</span>
          </div>
        </div>
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">Difficulty chips</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip chip-easy">Easy</span>
            <span class="chip chip-moderate">Moderate</span>
            <span class="chip">Challenging</span>
          </div>
        </div>
        <div class="card p-6 bg-[var(--color-forest-dark)]">
          <p class="eyebrow text-white/50">.trust-pill · on dark hero</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="trust-pill"><Icon name="certificate" size={12} /> TAT Licensed</span>
            <span class="trust-pill"><Icon name="star" size={12} /> 4.9★ Google</span>
            <span class="trust-pill"><Icon name="trees" size={12} /> Forest setting</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ CARDS ============ */}
  <section id="cards" class="py-12 lg:py-16 bg-[var(--color-cream)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <p class="eyebrow">Section 8</p>
      <h2 class="mt-3">Cards</h2>
      <p class="mt-3 text-[var(--color-mute)]">Container surfaces with border and rounded corners.</p>

      <div class="mt-10 grid sm:grid-cols-2 gap-4">
        <div>
          <p class="eyebrow text-[var(--color-stone)]">.card · default</p>
          <div class="mt-3 card p-5">
            <h3 class="font-display text-[1.15rem]">Card title</h3>
            <p class="mt-2 text-[0.92rem] text-[var(--color-soil)]">Default card has a 1px line border, paper background, and 12px border-radius.</p>
          </div>
        </div>
        <div>
          <p class="eyebrow text-[var(--color-stone)]">.card.card-lift · hover lift</p>
          <div class="mt-3 card card-lift p-5">
            <h3 class="font-display text-[1.15rem]">Hover me</h3>
            <p class="mt-2 text-[0.92rem] text-[var(--color-soil)]">Adds transform + shadow-lift on hover. Used for interactive cards (tour cards, stay cards).</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ FORMS ============ */}
  <section id="forms" class="py-12 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Section 9</p>
      <h2 class="mt-3">Form inputs</h2>
      <p class="mt-3 text-[var(--color-mute)]">Inputs used in booking forms.</p>

      <div class="mt-10 max-w-md grid gap-4">
        <label class="grid gap-1.5">
          <span class="eyebrow">Text input</span>
          <input type="text" placeholder="e.g. Full name" class="form-input" />
        </label>
        <label class="grid gap-1.5">
          <span class="eyebrow">Email</span>
          <input type="email" placeholder="you@example.com" class="form-input" />
        </label>
        <label class="grid gap-1.5">
          <span class="eyebrow">Select dropdown</span>
          <select class="form-input">
            <option>Half Day Elephant Care Experience</option>
            <option>Full Day Elephant Care Experience</option>
          </select>
        </label>
        <label class="grid gap-1.5">
          <span class="eyebrow">Textarea</span>
          <textarea rows="3" placeholder="Any special requests..." class="form-input resize-none"></textarea>
        </label>
      </div>
    </div>
  </section>

  {/* ============ CALLOUTS ============ */}
  <section id="callouts" class="py-12 lg:py-16 bg-[var(--color-cream)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <p class="eyebrow">Section 10</p>
      <h2 class="mt-3">Callouts</h2>
      <p class="mt-3 text-[var(--color-mute)]">Highlighted notices and program info.</p>

      <div class="mt-10 grid gap-4 max-w-2xl">
        <div>
          <p class="eyebrow text-[var(--color-stone)]">.anti-scam · amber warning</p>
          <div class="mt-3 anti-scam">
            <Icon name="shield" size={16} />
            <div>
              <p class="font-medium text-[0.85rem] text-[var(--color-ink)]">Stay Safe</p>
              <p class="text-[0.82rem] text-[var(--color-soil)] mt-0.5 leading-snug">Tony only sends payment details personally via WhatsApp and never through third-party links.</p>
            </div>
          </div>
        </div>
        <div>
          <p class="eyebrow text-[var(--color-stone)]">Program note · sage callout (custom)</p>
          <div class="mt-3 bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] rounded-xl p-5 flex items-center gap-4">
            <Icon name="elephant" size={48} class="text-[var(--color-forest-dark)] shrink-0" />
            <p class="text-[0.95rem] text-[var(--color-forest-dark)] font-medium leading-relaxed" style="font-family: var(--font-body);">All activities are gentle and unforced, allowing the elephants to live peacefully in their final home.</p>
          </div>
        </div>
        <div>
          <p class="eyebrow text-[var(--color-stone)]">Time slot card · sage + amber icon</p>
          <div class="mt-3 bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] rounded-xl p-5 grid gap-3">
            <div class="flex items-center gap-3">
              <Icon name="sun" size={22} class="text-[var(--color-amber)] shrink-0" />
              <p class="text-[0.98rem] text-[var(--color-soil)] leading-snug">
                <span class="font-display text-[1.1rem] text-[var(--color-forest)]">Morning</span>
                <span class="ml-2">pick up 8.00 – 8.30 am</span>
              </p>
            </div>
            <div class="flex items-center gap-3">
              <Icon name="cloud-sun" size={22} class="text-[var(--color-amber)] shrink-0" />
              <p class="text-[0.98rem] text-[var(--color-soil)] leading-snug">
                <span class="font-display text-[1.1rem] text-[var(--color-forest)]">Afternoon</span>
                <span class="ml-2">pick up 12.00 – 12.30 pm</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ LINKS ============ */}
  <section id="links" class="py-12 lg:py-16">
    <div class="wrap">
      <p class="eyebrow">Section 11</p>
      <h2 class="mt-3">Links</h2>
      <p class="mt-3 text-[var(--color-mute)]">Animated underline link style.</p>

      <div class="mt-10 grid gap-4 max-w-xl">
        <div class="card p-6">
          <p class="eyebrow text-[var(--color-stone)]">.ulink · animated underline (hover)</p>
          <p class="mt-3 text-[var(--color-ink)]">
            Read more about our story — <a href="#" class="ulink">visit the About page</a> — and explore Tony's journey.
          </p>
        </div>
      </div>
    </div>
