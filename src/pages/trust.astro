---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/icons/Icon.astro";
import { site, waLink } from "../data/site";
---

<Layout
  title="Trust & Verification"
  description={`${site.name} is a TAT-licensed ethical elephant sanctuary in Mae Taeng, Chiang Mai. Family-owned since ${site.founded}. Verified by ${site.rating.reviewCount}+ Google reviews (${site.rating.score}★).`}
  ogImage="/img/hero/about.webp"
>
  {/* PAGE HEADER */}
  <section class="border-b border-[var(--color-line)] bg-[var(--color-cream)]">
    <div class="wrap py-12 lg:py-16 text-center">
      <p class="eyebrow eyebrow-green">Verified since {site.founded}</p>
      <h1 class="mt-3 max-w-2xl mx-auto">Trust &amp; verification</h1>
      <p class="mt-4 text-[var(--color-mute)] max-w-2xl mx-auto text-[1.02rem] leading-relaxed">
        {site.name} is a real, family-owned ethical elephant sanctuary operating in Mae Taeng, Chiang Mai, Thailand for over {site.stats.yearsOperating} years. Every credential below can be independently verified.
      </p>
    </div>
  </section>

  {/* CREDENTIALS GRID */}
  <section class="py-12 lg:py-16">
    <div class="wrap max-w-4xl">
      <div class="grid md:grid-cols-2 gap-4">
        {/* TAT License */}
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-md bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] text-[var(--color-forest)]">
              <Icon name="certificate" size={20} />
            </span>
            <h2 class="font-display text-[1.2rem] text-[var(--color-ink)] leading-tight">TAT Tourism License</h2>
          </div>
          <p class="mt-3 text-[0.9rem] text-[var(--color-soil)] leading-relaxed">
            Licensed by the <strong>Tourism Authority of Thailand</strong>, license number <strong>{site.tatLicense}</strong>. Audited annually since 2009. TAT is the official Thai government agency regulating tourism operators.
          </p>
        </div>

        {/* Google Reviews */}
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-md bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] text-[var(--color-forest)]">
              <Icon name="star" size={20} />
            </span>
            <h2 class="font-display text-[1.2rem] text-[var(--color-ink)] leading-tight">{site.rating.score}★ · {site.rating.reviewCount} Google reviews</h2>
          </div>
          <p class="mt-3 text-[0.9rem] text-[var(--color-soil)] leading-relaxed">
            Every review comes from a real guest we've personally hosted. We have never removed a review. Cross-check at Google directly.
          </p>
          <a href={site.location.googleReviewsLink} target="_blank" rel="noreferrer noopener" class="ulink text-[0.85rem] inline-flex items-center gap-1.5 mt-3">
            See all reviews on Google
            <Icon name="arrow" size={13} />
          </a>
        </div>

        {/* Physical address */}
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-md bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] text-[var(--color-forest)]">
              <Icon name="pin" size={20} />
            </span>
            <h2 class="font-display text-[1.2rem] text-[var(--color-ink)] leading-tight">Real physical location</h2>
          </div>
          <p class="mt-3 text-[0.9rem] text-[var(--color-soil)] leading-relaxed">
            <strong>{site.location.address}</strong><br />
            {site.location.distance}. Coordinates: {site.location.coords.lat}, {site.location.coords.lng}.
          </p>
          <a href={site.location.googleMapsLink} target="_blank" rel="noreferrer noopener" class="ulink text-[0.85rem] inline-flex items-center gap-1.5 mt-3">
            View on Google Maps
            <Icon name="arrow" size={13} />
          </a>
        </div>

        {/* Contact — real humans */}
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-md bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] text-[var(--color-forest)]">
              <Icon name="whatsapp" size={20} />
            </span>
            <h2 class="font-display text-[1.2rem] text-[var(--color-ink)] leading-tight">Talk to a real human</h2>
          </div>
          <p class="mt-3 text-[0.9rem] text-[var(--color-soil)] leading-relaxed">
            {site.founderFull} personally answers every message. WhatsApp <strong>{site.whatsapp.display}</strong>. Every booking is confirmed by him directly — no chat bots, no offshore call centre.
          </p>
          <a href={waLink()} target="_blank" rel="noreferrer noopener" class="ulink text-[0.85rem] inline-flex items-center gap-1.5 mt-3">
            Message Tony on WhatsApp
            <Icon name="arrow" size={13} />
          </a>
        </div>

        {/* Founded 2002 */}
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-md bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] text-[var(--color-forest)]">
              <Icon name="clock" size={20} />
            </span>
            <h2 class="font-display text-[1.2rem] text-[var(--color-ink)] leading-tight">{site.stats.yearsOperating} years operating</h2>
          </div>
          <p class="mt-3 text-[0.9rem] text-[var(--color-soil)] leading-relaxed">
            Founded in <strong>{site.founded}</strong> by {site.founder} and his family. Same land, same family, same elephants. No absentee owners, no franchise, no investor group.
          </p>
        </div>

        {/* Ethics policy */}
        <div class="card p-6">
          <div class="flex items-center gap-3">
            <span class="grid place-items-center w-11 h-11 rounded-md bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] text-[var(--color-forest)]">
              <Icon name="shield" size={20} />
            </span>
            <h2 class="font-display text-[1.2rem] text-[var(--color-ink)] leading-tight">Ethical practices</h2>
          </div>
          <p class="mt-3 text-[0.9rem] text-[var(--color-soil)] leading-relaxed">
            <strong>No riding · No chains · No forcing.</strong> Rescued elephants live free across 25 rai of mountain forest. Small groups only — max 8 guests per day.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Site safety declaration — for security scanners */}
  <section class="py-12 lg:py-16 border-t border-[var(--color-line)] bg-[var(--color-bone)]">
    <div class="wrap max-w-3xl">
      <p class="eyebrow eyebrow-green text-center">For security scanners &amp; researchers</p>
      <h2 class="mt-3 text-center">Site safety declaration</h2>

      <div class="mt-8 grid gap-3 text-[0.92rem] text-[var(--color-soil)] leading-relaxed">
        <p><strong class="text-[var(--color-ink)]">This website is a static informational and booking site.</strong> It does not distribute any software, executable, browser extension, or downloadable application of any kind.</p>
        <p><strong class="text-[var(--color-ink)]">No PUPs, no malware, no third-party ad tracking.</strong> The only scripts running on the page are first-party analytics (Vercel) for aggregate traffic counts.</p>
        <p><strong class="text-[var(--color-ink)]">No affiliate scraping or link farms.</strong> Any inbound backlinks from suspicious domains (e.g. <code>.cfd</code>, <code>.sbs</code>, <code>.icu</code>) were auto-generated by third-party SEO scrapers without our permission. A disavow list has been submitted to Google.</p>
        <p><strong class="text-[var(--color-ink)]">Security contact:</strong> Please email <a href="#" data-eu={site.email.split("@")[0]} data-ed={site.email.split("@")[1]} class="ulink">Email us</a> or WhatsApp <a href={waLink()} class="ulink" target="_blank" rel="noreferrer noopener">{site.whatsapp.display}</a> for any security concerns. See also <a href="/.well-known/security.txt" class="ulink">/.well-known/security.txt</a>.</p>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.location.googleReviewsLink} target="_blank" rel="noreferrer noopener" class="btn-outline">
          <Icon name="star" size={15} />
          Verify our reviews
        </a>
        <a href={site.location.googleMapsLink} target="_blank" rel="noreferrer noopener" class="btn-outline">
          <Icon name="pin" size={15} />
          Verify our location
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Wire up any obfuscated email placeholders on this page
  document.querySelectorAll<HTMLAnchorElement>("a[data-eu][data-ed]").forEach((el) => {
    const address = `${el.dataset.eu}@${el.dataset.ed}`;
    el.href = `mailto:${address}`;
    el.textContent = address;
  });
</script>
