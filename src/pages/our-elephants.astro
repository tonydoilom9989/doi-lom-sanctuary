---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/icons/Icon.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { testimonials } from "../data/testimonials";
import { site, waLink } from "../data/site";

const reviewQuote = testimonials[1];

const herdTraits = ["Gentle", "Love bananas", "Love mud baths", "Protective of the herd"];

const herdTimeline = [
  { year: "Born", description: "Born in northern Thailand and rescued into the tourism industry." },
  { year: "2002", description: "Rescued by Tony and rescued to Doi Lom Rescue." },
  {
    year: "Today",
    description:
      "Living peacefully at Doi Lom Rescue. Guests can learn more about each elephant's individual story during their visit.",
    isCurrent: true,
  },
];

const herdThumbs = [
  "/img/elephants/thumb-1.png",
  "/img/elephants/thumb-2.png",
  "/img/elephants/thumb-3.png",
];
---

<Layout
  title="Meet Our Rescued Elephants"
  description="Three rescued Asian elephants now living free at Doi Lom Sanctuary, Mae Taeng. Each elephant has its own story, personality, and a peaceful retirement after years of exploitation."
  ogImage="/img/hero/elephants.png"
>
  {/* ============ HERO ============ */}
  <section class="relative overflow-hidden bg-[var(--color-forest-dark)] text-white">
    <img
      src="/img/hero/elephants.png"
      alt="Rescued Asian elephants living peacefully at Doi Lom Sanctuary in the hills of Mae Taeng"
      class="absolute inset-0 w-full h-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-black/30"></div>

    <div class="wrap relative py-16 lg:py-20">
      <div class="max-w-2xl reveal">
        <p class="eyebrow !text-white">Our Family</p>
        <h1 class="mt-4 font-display italic text-white leading-[1.04]">Meet Our Family</h1>
        <p class="mt-6 text-[1.08rem] text-white/85 leading-relaxed max-w-xl">
          A lucky herd of elephants, each with a different story, but all sharing one home. Each one was rescued from a difficult life — and has finally come here to live in peace.
        </p>
        <button type="button" data-book-now class="btn-primary mt-8">
          Book an experience
        </button>
      </div>
    </div>
  </section>

  {/* ============ THE ELEPHANTS OF DOI LOM — collective story ============ */}
  <section class="py-16 lg:py-20 bg-[var(--color-paper)]">
    <div class="wrap">
      <div class="grid lg:grid-cols-[1.1fr_1.3fr] gap-10 lg:gap-16 items-start">
        {/* Photo column */}
        <div class="reveal">
          <div class="frame aspect-[4/3] lg:aspect-[5/4]" style="background-color:#c8ddb8">
            <img src="/img/elephants/main.png" alt="The elephants of Doi Lom" loading="lazy" class="w-full h-full object-cover"/>
          </div>
          <div class="mt-3 grid grid-cols-3 gap-3">
            {herdThumbs.map((t, ti) => (
              <div class="aspect-[4/3] rounded-md overflow-hidden bg-[var(--color-leaf-100)]">
                <img src={t} alt={`Elephant ${ti + 1}`} loading="lazy" class="w-full h-full object-cover"/>
              </div>
            ))}
          </div>
        </div>

        {/* Story column */}
        <div class="reveal">
          <p class="eyebrow">A story</p>
          <h2 class="mt-3 font-display text-[clamp(1.9rem,4vw,2.6rem)] text-[var(--color-ink)] leading-[1.05]">The Elephants of Doi Lom</h2>

          <div class="mt-6 text-[var(--color-soil)] leading-[1.75] text-[1.02rem] space-y-4">
            <p>Tony rescued elephants that had been heavily used in different places — some were used for logging, while others spent their days carrying tourists with large chairs strapped to their backs.</p>
            <p>They were rescued to Doi Lom Rescue, a warm new home surrounded by nature, with a spacious elephant shelter to protect them from the rain. Tony and the Doi Lom team have put their hearts, effort, and resources into giving these elephants a peaceful retirement, where they no longer have to be exploited.</p>
          </div>

          {/* Pull quote */}
          <blockquote class="mt-7 pl-5 border-l border-[var(--color-line-sage)]">
            <p class="font-display italic text-[1.15rem] text-[var(--color-forest)] leading-snug">"Every elephant here is like my family. We have lived together for more than 20 years. They are so gentle that sometimes I just want to step away from the outside world and spend time with them."</p>
            <footer class="mt-2 text-[0.78rem] text-[var(--color-mute)] tracking-wide">— Tony, Founder</footer>
          </blockquote>

          {/* Personalities */}
          <div class="mt-7">
            <p class="eyebrow">Their personalities</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {herdTraits.map((t) => <span class="chip chip-sage">{t}</span>)}
            </div>
          </div>

          {/* Journey timeline */}
          <div class="mt-8">
            <p class="eyebrow">Their journey</p>
            <ol class="mt-4 relative">
              {herdTimeline.map((step, ti) => (
                <li class="grid grid-cols-[18px_1fr] gap-3 pb-4 last:pb-0 relative">
                  <div class="relative flex justify-center">
                    <span class:list={[
                      "block rounded-full mt-1",
                      step.isCurrent ? "w-3 h-3 bg-[var(--color-forest)]" : "w-2.5 h-2.5 bg-[var(--color-line-sage)]",
                    ]}></span>
                    {ti < herdTimeline.length - 1 && (
                      <span class="absolute top-4 bottom-[-4px] w-px bg-[var(--color-line)]"></span>
                    )}
                  </div>
                  <div>
                    <span class:list={["text-[0.78rem] font-medium tracking-wide", step.isCurrent ? "text-[var(--color-forest)]" : "text-[var(--color-mute)]"]}>{step.year}</span>
                    <p class="text-[0.95rem] text-[var(--color-soil)] mt-1 leading-snug">{step.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ ETHICAL COMMITMENT ============ */}
  <section class="py-16 lg:py-20 bg-[var(--color-cream)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto reveal">
        <p class="eyebrow">Our Ethical Commitment</p>
        <h2 class="mt-4 font-display">No riding. No chains. No forcing.</h2>
        <p class="mt-5 text-[var(--color-soil)] leading-relaxed">The three principles that have guided every decision at Doi Lom since day one.</p>
      </div>

      {/* 3 statement pills */}
      <div class="mt-12 grid md:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {[
          { icon: "ban", title: "No riding", desc: "Ever, for any reason." },
          { icon: "unlock", title: "No chains", desc: "Day or night." },
          { icon: "x-circle", title: "No forcing", desc: "No more labor or forced work for them." },
        ].map((p, i) => (
          <div class="bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] rounded-xl p-5 flex items-center gap-4 reveal" style={`transition-delay:${i * 60}ms`}>
            <div class="grid place-items-center w-12 h-12 rounded-full bg-[var(--color-forest)] text-white shrink-0">
              <Icon name={p.icon} size={22} />
            </div>
            <div>
              <p class="font-display text-[1.15rem] text-[var(--color-ink)]">{p.title}</p>
              <p class="text-[0.85rem] text-[var(--color-soil)] mt-0.5">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

      {/* 6 commitment cards 2×3 */}
      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {[
          { icon: "trees", title: "Natural habitat", desc: "Over 25 rai of protected mountain land, where the elephants can roam freely." },
          { icon: "users", title: "Family owned", desc: "Run by Tony and the local team." },
          { icon: "apple", title: "Natural elephant diet only", desc: "Forest fruits and sugarcane grown on-site." },
          { icon: "heart", title: "Rescue & rehabilitation", desc: "Every elephant has been rescued from exploitation." },
          { icon: "certificate", title: "TAT certified", desc: `License No. ${site.tatLicense} and audited annually.` },
          { icon: "home", title: "Community first", desc: "A local team from Mae Taeng village." },
        ].map((c, i) => (
          <div class="card p-5 reveal flex items-center gap-4" style={`transition-delay:${i * 50}ms`}>
            <div class="grid place-items-center w-11 h-11 rounded-md bg-[var(--color-leaf-50)] border border-[var(--color-line-sage)] text-[var(--color-forest)] shrink-0">
              <Icon name={c.icon} size={20} />
            </div>
            <div>
              <p class="font-display text-[1.05rem] text-[var(--color-ink)]">{c.title}</p>
              <p class="text-[0.86rem] text-[var(--color-soil)] mt-1 leading-snug">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ CTA + REVIEW ============ */}
  <section class="py-16 lg:py-20">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-5">
        <div class="bg-[var(--color-bone)] rounded-xl p-7 lg:p-9 flex flex-col justify-center reveal">
          <h3 class="font-display text-[1.7rem] lg:text-[2rem] text-[var(--color-ink)] leading-tight">Ready to spend a day with them?</h3>
          <p class="mt-3 text-[var(--color-soil)] leading-relaxed">Book and experience the elephants up close — at their pace.</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href="/tours" class="btn-primary flex-1 justify-center">View all tours</a>
            <a href={waLink()} target="_blank" rel="noreferrer noopener" class="btn-whatsapp flex-1 justify-center">
              <Icon name="whatsapp" size={16} />
              Chat with Tony
            </a>
          </div>
        </div>
        <div class="reveal flex flex-col">
          <ReviewCard review={reviewQuote} />
          <a href={site.location.googleReviewsLink} target="_blank" rel="noreferrer noopener" class="ulink text-[0.92rem] inline-flex items-center gap-1.5 mt-4 self-start">
            See all {site.rating.reviewCount} reviews on Google
            <Icon name="arrow" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
