---
import { site } from "../data/site";
const stats = [
  { value: site.stats.rescued, label: "Elephants in our care" },
  { value: site.stats.yearsRunning, label: "Years running" },
  { value: site.stats.hectares, label: "Hectares of forest reserve" },
  { value: site.stats.visitorsPerYear, label: "Annual visitors · all happy" },
];
---

<section class="bg-[var(--color-bone)] border-y border-[var(--color-line)]">
  <div class="wrap py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      {stats.map((s, i) => (
        <div class:list={["text-center md:text-left reveal", i > 0 && "md:border-l md:border-[var(--color-line)] md:pl-8"]}>
          <p class="font-display text-[clamp(2.4rem,4.5vw,3.2rem)] text-[var(--color-bark)] leading-none font-light">
            {s.value}
          </p>
          <p class="mt-3 text-[0.78rem] uppercase tracking-[0.18em] text-[var(--color-mute)] leading-snug">
            {s.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
