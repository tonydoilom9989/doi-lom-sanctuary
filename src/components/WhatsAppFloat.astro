---
import { waLink, site } from "../data/site";
import Icon from "./icons/Icon.astro";
---

<a
  id="wa-float"
  href={waLink()}
  target="_blank"
  rel="noreferrer noopener"
  aria-label={`Chat with ${site.founder} on WhatsApp`}
  class="fixed bottom-5 right-5 md:bottom-7 md:right-7 z-30 grid place-items-center w-[52px] h-[52px] rounded-full bg-[var(--color-wa)] text-white shadow-[0_16px_36px_-12px_rgba(37,211,102,0.55)] hover:bg-[var(--color-wa-dark)] hover:scale-105 transition-all duration-300 opacity-0 translate-y-2 pointer-events-none"
  data-visible="false"
>
  <span aria-hidden="true" class="absolute inset-0 rounded-full bg-white/10 animate-ping pointer-events-none"></span>
  <Icon name="whatsapp" size={26} />
</a>

<script>
  // Show FAB only after user scrolls past the hero (200px threshold)
  const fab = document.getElementById("wa-float");
  if (fab) {
    const onScroll = () => {
      const visible = window.scrollY > 200;
      fab.dataset.visible = String(visible);
      fab.style.opacity = visible ? "1" : "0";
      fab.style.transform = visible ? "translateY(0)" : "translateY(8px)";
      fab.style.pointerEvents = visible ? "auto" : "none";
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
